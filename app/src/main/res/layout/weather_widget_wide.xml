<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background_ubuntu" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">
    <TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:maxLines="1" android:text="@string/widget_value_missing" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/widget_place" android:layout_width="match_parent" android:layout_height="11dp"
            android:maxLines="1" android:ellipsize="end" android:text="@string/widget_initial_place" android:textSize="9sp" android:textColor="#FFFFFF" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_wind" android:layout_width="match_parent" android:layout_height="11dp"
            android:maxLines="1" android:ellipsize="end" android:text="@string/widget_initial_wind" android:textSize="9sp" android:textColor="#FFFFFF" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/widget_source" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:maxLines="1" android:text="@string/widget_initial_source" android:textSize="8sp" android:textColor="#D4BBCC" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp"
                android:maxLines="1" android:ellipsize="end" android:text="@string/widget_value_missing" android:textSize="8sp" android:textColor="#D4BBCC" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="20dp" android:layout_height="match_parent" android:padding="2dp"
        android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/widget_refresh" />
</LinearLayout>
