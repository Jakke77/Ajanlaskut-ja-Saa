<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background_ubuntu" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_place" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end" android:text="@string/widget_initial_forecast" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false" />
        <ImageView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="24dp" android:padding="4dp"
            android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="25dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:text="@string/widget_value_missing" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_source" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp"
            android:maxLines="1" android:ellipsize="end" android:text="@string/widget_initial_source" android:textSize="10sp" android:textColor="#D4BBCC" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:text="@string/widget_no_forecast" android:textSize="9sp" android:textColor="#D4BBCC" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_graph" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitXY" android:contentDescription="@string/widget_forecast_graph" />
</LinearLayout>
