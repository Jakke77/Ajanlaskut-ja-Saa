[Icon Theme]
Name=Ajanlaskut · Ubuntu 26.10 Dark
Comment=Ajanlaskut ja Sää -widgetin Ubuntu 26.10 Dark-väripaletti
Inherits=Yaru,Adwaita,hicolor
Directories=scalable/apps,scalable/places,scalable/mimetypes,scalable/devices,scalable/status,symbolic/status
Example=ajanlaskut-ja-saa

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/devices]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/status]
